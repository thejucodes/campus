# CampusPulse Environment Configuration (.env.example)

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication & Role Authorization
JWT_SECRET=campuspulse-synesis26-jwt-top-secret

# HMAC Salt for Cryptographic QR Ticket Signing
QR_SECRET=campuspulse-synesis26-secure-secret-salt-forest-ivory

# Optional: Google Gemini API Key for AI Flyer Image Extraction
# If omitted or empty, CampusPulse automatically enables graceful manual editable draft mode.
# Organizers can still upload poster images, view previews, and edit all event details.
GEMINI_API_KEY=your_gemini_api_key_here
